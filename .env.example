# ==============================================================================
# EduManage 360 - Environment Configuration Template
# COPY THIS FILE TO .env AND SET STRONG, UNIQUE CREDENTIALS FOR YOUR ENVIRONMENT
# NEVER COMMIT REAL CREDENTIALS OR LIVE .env FILES TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Operational Mode
# Options: development, test, staging, production
# In production, startup fails safely if default or insecure secrets are detected.
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database Configuration
# Local Development (Default):
DATABASE_URL=sqlite:///./school.db
# Production (Render / PostgreSQL):
# DATABASE_URL=postgresql://db_user:db_password@db_host:5432/edumanage_db

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Secrets
# Generate a strong 256-bit random key (e.g. `openssl rand -hex 32`)
# ------------------------------------------------------------------------------
SECRET_KEY=your-secure-random-256-bit-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Root Super-Administrator Password (required for first-run bootstrap in production)
# INITIAL_SUPERADMIN_PASSWORD=your-initial-strong-superadmin-password

# ------------------------------------------------------------------------------
# 4. Network & CORS Configuration
# Comma-separated list of trusted origins (never use wildcard '*' in production)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://smsghana.onrender.com

# ------------------------------------------------------------------------------
# 5. Payment Gateway (Paystack Ghana)
# ------------------------------------------------------------------------------
PAYSTACK_ENABLED=false
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
PAYSTACK_SECRET_KEY=sk_test_placeholder

# ------------------------------------------------------------------------------
# 6. SMS Gateway (Hubtel Ghana)
# ------------------------------------------------------------------------------
HUBTEL_ENABLED=false
HUBTEL_CLIENT_ID=placeholder_hubtel_client_id
HUBTEL_CLIENT_SECRET=placeholder_hubtel_client_secret
