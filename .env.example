# ==============================================================================
# EduManage 360 - Enterprise Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' at the repository root:
#    Windows:  copy .env.example .env
#    Linux/Mac: cp .env.example .env
# 2. Populate strong, unique credentials for your target environment.
# 3. CRITICAL SECURITY: Never commit '.env' files or real API keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Server Runtime
# ------------------------------------------------------------------------------
# Operational mode: 'development', 'test', 'staging', or 'production'
# Note: In production mode, startup fails safely if default or insecure secrets are detected.
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
SMS_APP_PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Database Configuration (Dual-Engine Architecture)
# ------------------------------------------------------------------------------
# Local Offline School Deployment (Default - Zero-setup SQLite WAL mode):
DATABASE_URL=sqlite:///./school.db

# Production Enterprise Cloud / Multi-Campus Deployment (PostgreSQL):
# DATABASE_URL=postgresql://edumanage_user:strong_password@localhost:5432/edumanage_db

# PostgreSQL Connection Pool Tuning (Ignored for SQLite):
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Cryptography (OWASP ASVS v4.0)
# ------------------------------------------------------------------------------
# Generate a strong 256-bit random key via: openssl rand -hex 32
SECRET_KEY=your-secure-random-256-bit-secret-key-here
JWT_SECRET_KEY=your-secure-random-256-bit-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Bootstrap Super-Administrator Password (required only for first-run bootstrap in production)
# INITIAL_SUPERADMIN_PASSWORD=change-me-to-a-strong-password-123!

# Multi-Device Zero-Trust Session Enforcement (true/false)
ENFORCE_SINGLE_DEVICE_SESSION=true

# ------------------------------------------------------------------------------
# 4. Network Security & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origin URLs (never use wildcard '*' in production)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://smsghana.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# ------------------------------------------------------------------------------
# 5. File Uploads & Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=frontend/uploads
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------------------------
# 6. Payment Gateways (Optional Online Extensions)
# ------------------------------------------------------------------------------
# In 100% offline school mode, set PAYSTACK_ENABLED=false
PAYSTACK_ENABLED=false
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key
PAYSTACK_SECRET_KEY=sk_test_placeholder_key
PAYSTACK_WEBHOOK_SECRET=placeholder_webhook_secret

# ------------------------------------------------------------------------------
# 7. SMS Communication Gateways (Optional Online Extensions)
# ------------------------------------------------------------------------------
# In 100% offline school mode, HUBTEL_ENABLED=false and SMS dispatches are simulated
HUBTEL_ENABLED=false
HUBTEL_CLIENT_ID=placeholder_hubtel_client_id
HUBTEL_CLIENT_SECRET=placeholder_hubtel_client_secret
HUBTEL_SENDER_ID=EduManage

# Alternative Regional SMS Provider (Arkesel / MNotify)
ARKESEL_SMS_API_KEY=placeholder_arkesel_api_key
ARKESEL_SENDER_ID=EduManage

# ------------------------------------------------------------------------------
# 8. Disaster Recovery & Automated Backups
# ------------------------------------------------------------------------------
BACKUP_DIR=backups
BACKUP_RETENTION_COUNT=30
AUTO_BACKUP_ON_STARTUP=true
