# Database Configuration
DATABASE_URL=sqlite:///d:/documents/my apps/SMS/school.db
# For PostgreSQL in production, set:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/school_db

# Security & Authentication Secrets
SECRET_KEY=sms_prod_secret_key_change_in_production_987654321
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & CORS Configuration
CORS_ORIGINS=*

# Paystack Payment Gateway & Subaccount Split
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_ENABLED=false

# Hubtel SMS Gateway & Dynamic Sender ID
HUBTEL_CLIENT_ID=mock_client_id
HUBTEL_CLIENT_SECRET=mock_client_secret

